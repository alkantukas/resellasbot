# Paste your bot token after the = sign (Developer Portal → your app → Bot → Reset Token).
# Never share this token or post it anywhere.
DISCORD_TOKEN=

# Optional: your server's ID. Commands then show up there instantly.
# Leave empty to register them for every server the bot is in.
GUILD_ID=

# Optional: time zone used to read giveaway dates like 2026-10-31.
TIMEZONE=Europe/Vilnius

# Optional: name shown at the bottom of every embed.
BRAND_NAME=Resell Zone

# Optional: where settings and giveaways are saved.
DATA_FILE=data/db.json
